meta {
  name: CreateProducts
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/api/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{JWT}}
}

body:json {
  {
    "name": "Acer Aspire 5",
    "description": "Budget-friendly laptop designed for students and everyday productivity with dependable performance.",
    "brand": "Acer",
    "currentPrice": 44999,
    "category": "6a9b0d310df800a790dad68c",
    "stock": 65,
    "images": [
      {
        "url": "https://dummyimage.com/acer-aspire5-front.jpg",
        "publicId": "acer-aspire5-front"
      },
      {
        "url": "https://dummyimage.com/acer-aspire5-back.jpg",
        "publicId": "acer-aspire5-back"
      }
    ],
    "tags": [
      "acer",
      "aspire",
      "budget",
      "student",
      "productivity"
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
